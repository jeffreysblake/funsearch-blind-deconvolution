# FunSearch Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# Backend API URL (default: http://localhost:7351)
VITE_API_BASE_URL=http://localhost:7351

# WebSocket URL (default: ws://localhost:7351)
VITE_WS_BASE_URL=ws://localhost:7351

# Application settings
VITE_APP_NAME=FunSearch Framework
VITE_APP_VERSION=0.1.0

# Feature flags (optional)
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false
